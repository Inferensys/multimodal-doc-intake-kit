{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferensys.github.io/multimodal-doc-intake-kit/normalized-document.schema.json",
  "title": "NormalizedDocument",
  "type": "object",
  "required": [
    "document_id",
    "profile",
    "status",
    "extracted_fields",
    "chunks"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "normalized",
        "review_pending",
        "reviewed",
        "exported"
      ]
    },
    "source_checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extracted_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "confidence",
          "provenance"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance": {
            "type": "object",
            "required": [
              "page",
              "bbox"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                },
                "description": "[x0, y0, x1, y1] in page coordinate space"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "text",
          "section_path",
          "page"
        ],
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "section_path": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "char_start": {
            "type": "integer",
            "minimum": 0
          },
          "char_end": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
