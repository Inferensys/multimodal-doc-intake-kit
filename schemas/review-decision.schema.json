{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferensys.github.io/multimodal-doc-intake-kit/review-decision.schema.json",
  "title": "ReviewDecision",
  "type": "object",
  "required": [
    "document_id",
    "reviewer_id",
    "field_decisions",
    "submitted_at"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "field_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field_name",
          "action",
          "reason_code"
        ],
        "properties": {
          "field_name": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "correct",
              "drop"
            ]
          },
          "corrected_value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "ocr_error",
              "layout_misalignment",
              "parser_miss",
              "domain_override"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
